{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedImports": "warn"
      },
      "style": {
        "noDefaultExport": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "files": {
    "includes": [
      "scripts/**/*.ts",
      "packages/**/*.ts",
      "packages/**/*.tsx",
      "e2e/**/*.ts",
      "playwright.config.ts",
      "vitest.config.ts",
      "!**/node_modules",
      "!**/dist",
      "!.worktrees",
      "!test-results",
      "!.playwright-mcp"
    ]
  },
  "overrides": [
    {
      "includes": ["**/vite.config.ts", "**/vitest.config.ts", "playwright.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ]
}
